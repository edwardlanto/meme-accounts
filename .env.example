# Cloudflare R2 (S3-compatible). Previews upload via POST /api/r2/upload (server → R2).
# Browser reads use signed GET URLs; if images fail to load, add R2 bucket CORS for GET.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

PUBLIC_SUPABASE_URL=your_supabase_project_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
OPENROUTER_API_KEY=your_openrouter_api_key

# Google Vertex — Imagen (studio images) + Gemini (Videos clip AI)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_IMAGEN_MODEL=imagen-4.0-generate-001
VERTEX_GEMINI_MODEL=gemini-2.0-flash-001
# Optional paths if binaries are not on PATH (Videos: yt-dlp + ffmpeg)
# YT_DLP_PATH=/opt/homebrew/bin/yt-dlp
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# Optional: if set, Brand Carousel (`/api/brand/generate`) uses Anthropic directly instead of OpenRouter.
CLAUDE_API_KEY=
APIFY_API_TOKEN=your_apify_api_token

# Server-side (OAuth integrations)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Queue / Worker
REDIS_URL=redis://localhost:6379

# Public app URL — required for Zernio OAuth redirect and public media URLs in tests.
# In production set to your deployed origin (e.g. https://app.example.com).
PUBLIC_APP_URL=

# Zernio — Facebook, Instagram, TikTok (scheduling + publish for these platforms)
# https://docs.zernio.com/
ZERNIO_API_KEY=
# Optional API base (default https://zernio.com/api/v1)
# ZERNIO_API_BASE=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
# Optional: override scopes; otherwise derived from which connect button you click.
LINKEDIN_SCOPES=

# Google Business Profile (Google My Business) OAuth
GMB_CLIENT_ID=
GMB_CLIENT_SECRET=
GMB_REDIRECT_URI=
# Optional: override scopes; defaults include https://www.googleapis.com/auth/business.manage
GMB_SCOPES=


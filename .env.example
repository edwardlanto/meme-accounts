# Cloudflare R2 (S3-compatible). Previews upload via POST /api/r2/upload (server → R2).
# Browser reads use signed GET URLs; if images fail to load, add R2 bucket CORS for GET.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

PUBLIC_SUPABASE_URL=your_supabase_project_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
OPENROUTER_API_KEY=your_openrouter_api_key
# Optional: if set, Brand Carousel (`/api/brand/generate`) uses Anthropic directly instead of OpenRouter.
CLAUDE_API_KEY=
APIFY_API_TOKEN=your_apify_api_token

# Server-side (OAuth integrations)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Queue / Worker
REDIS_URL=redis://localhost:6379

# Public app URL — used by /api/post-tests/* to build public media URLs for
# Instagram Graph (which cannot fetch localhost). In production set this to
# your deployed origin (e.g. https://app.example.com). For local IG testing,
# use an ngrok/cloudflared tunnel pointing at your dev server.
PUBLIC_APP_URL=

# Meta / Instagram (Business) OAuth
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_SCOPES=public_profile,pages_show_list,pages_manage_posts,pages_read_engagement,instagram_basic,instagram_content_publish

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
# Optional: override scopes; otherwise derived from which connect button you click.
LINKEDIN_SCOPES=

# Google Business Profile (Google My Business) OAuth
GMB_CLIENT_ID=
GMB_CLIENT_SECRET=
GMB_REDIRECT_URI=
# Optional: override scopes; defaults include https://www.googleapis.com/auth/business.manage
GMB_SCOPES=

# TikTok OAuth (Content Posting API)
# Register your app at https://developers.tiktok.com, enable Login Kit and
# Content Posting API. In sandbox mode (no app audit) you can test the full
# upload path — videos land in the user's Drafts inbox via the `video.upload`
# scope. Direct-posting requires the `video.publish` scope after audit.
# Redirect URI must be HTTPS and match exactly; use an ngrok tunnel in dev.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# Optional: override scopes. Default: user.info.basic,video.upload
TIKTOK_SCOPES=

# Cloudflare R2 (S3-compatible). Previews upload via POST /api/r2/upload (server → R2).
# Browser reads use signed GET URLs; if images fail to load, add R2 bucket CORS for GET.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

PUBLIC_SUPABASE_URL=your_supabase_project_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
OPENROUTER_API_KEY=your_openrouter_api_key

# Fal AI — studio / composer image generation (text-to-image + image edit)
# Text-to-image: google/nano-banana-2-lite | Edit: fal-ai/nano-banana-2/edit
FAL_AI_API_KEY=

# Unsplash — studio stock photo search (Access Key only; keep secret server-side)
UNSPLASH_ACCESS_KEY=
# Optional (OAuth apps only — not required for search)
# UNSPLASH_APPLICATION_ID=
# UNSPLASH_SECRET_KEY=

# Pexels — studio stock photo search (API Key; keep secret server-side)
PEXELS_API_KEY=

# Google Vertex — Gemini only (Videos clip AI). Imagen images now use Fal above.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.0-flash-001
# Optional paths if binaries are not on PATH (Videos: yt-dlp + ffmpeg + whisper + pyautoflip)
# YT_DLP_PATH=/opt/homebrew/bin/yt-dlp
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# WHISPER_PATH=/opt/homebrew/bin/whisper-cli
# After: npm run pyautoflip:install
# PYAUTOFLIP_PATH=/absolute/path/to/.venv-pyautoflip/bin/pyautoflip

# YouTube 403 fix — log into YouTube in the browser, then use ONE of:
# YT_DLP_COOKIES_BROWSER=chrome
# YT_DLP_COOKIES=/absolute/path/to/youtube-cookies.txt

# Optional: brew install deno (yt-dlp uses it for YouTube JS). Override: YT_DLP_JS_RUNTIMES=deno
# Advanced: YT_DLP_EXTRACTOR_ARGS=player_client=default,-android_sdkless
# YT_DLP_PO_TOKEN=web.gvs+YOUR_TOKEN

# Rate Limit Prevention (if you encounter HTTP 429 errors):
# Skip subtitle downloads to avoid YouTube rate limits (captions from HTML will still work)
# YT_DLP_SKIP_SUBS=1

# Video compression settings (optional)
# VIDEO_MAX_HEIGHT=720
# VIDEO_CRF=28

# Whisper transcription settings (optional)
# Auto-generates captions for videos without subtitles
# Install: brew install whisper-cpp
# Download model: npm run whisper:download
# Models: tiny.en, base.en (default), small.en, medium.en, large-v3
# WHISPER_MODEL=base.en
# WHISPER_MODELS_DIR=$HOME/.cache/whisper-cpp
# Optional: if set, Brand Carousel (`/api/brand/generate`) uses Anthropic directly instead of OpenRouter.
CLAUDE_API_KEY=
APIFY_API_TOKEN=your_apify_api_token

# Server-side (OAuth integrations)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Queue / Worker
REDIS_URL=redis://localhost:6379

# Public app URL — required for Zernio OAuth redirect, Stripe return URLs, and public media URLs.
# In production set to your deployed origin (e.g. https://app.example.com).
PUBLIC_APP_URL=

# Stripe — https://dashboard.stripe.com/apikeys
# Create Products + recurring Prices for Pro/Agency (monthly + yearly), paste price IDs below.
# Webhook endpoint: POST {PUBLIC_APP_URL}/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.updated,
#         customer.subscription.deleted, invoice.paid, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_YEARLY=

# Zernio — Facebook, Instagram, TikTok (scheduling + publish for these platforms)
# https://docs.zernio.com/
ZERNIO_API_KEY=
# Optional API base (default https://zernio.com/api/v1)
# ZERNIO_API_BASE=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
# Optional: override scopes; otherwise derived from which connect button you click.
LINKEDIN_SCOPES=

# Google Business Profile (Google My Business) OAuth
GMB_CLIENT_ID=
GMB_CLIENT_SECRET=
GMB_REDIRECT_URI=
# Optional: override scopes; defaults include https://www.googleapis.com/auth/business.manage
GMB_SCOPES=

